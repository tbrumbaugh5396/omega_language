{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "business-control",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["scripts/launch.py", "--port", "8860", "--host", "0.0.0.0"],
      "port": 8860,
      "autoPort": false
    },
    {
      "name": "business-control-https",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["scripts/launch.py", "--port", "8443", "--host", "0.0.0.0", "--https"],
      "port": 8443,
      "url": "https://localhost:8443",
      "autoPort": false
    },
    {
      "name": "business-control-verify",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["scripts/launch.py", "--port", "8861"],
      "port": 8861,
      "autoPort": false
    }
  ]
}
